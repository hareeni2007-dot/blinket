NODE_ENV=development
PORT=5000
PAYU_ENV=test
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Use MongoDB Atlas for deployed environments. In-memory mode is local-development only.
MONGODB_URI=mongodb://127.0.0.1:27017/bluecodeos_payments

# Use your PayU TEST credentials first. Keep the salt on the backend only.
PAYU_MERCHANT_KEY=your_test_merchant_key
PAYU_MERCHANT_SALT=your_test_merchant_salt
# Optional overrides. Leave blank to use endpoints selected by PAYU_ENV.
PAYU_PAYMENT_URL=
PAYU_POST_SERVICE_URL=
# Public HTTPS endpoint configured in PayU for refund notifications.
PAYU_REFUND_CALLBACK_URL=

# Generate a unique random secret of at least 32 characters.
ADMIN_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
